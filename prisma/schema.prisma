// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// ============================================
// AUTHENTICATION (NextAuth.js)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// USERS (Course Reps)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  matricNumber  String?   @unique
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  courses  Course[]
}

// ============================================
// LOCATIONS (Pre-stored class venues)
// ============================================

model Location {
  id           String  @id @default(cuid())
  name         String // e.g., "LT1", "Room 204"
  building     String? // e.g., "Faculty of Science"
  latitude     Float
  longitude    Float
  radiusMeters Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions AttendanceSession[]
}

// ============================================
// COURSES
// ============================================

model Course {
  id          String @id @default(cuid())
  courseCode  String // e.g., "CSC301"
  courseTitle String // e.g., "Computer Architecture"
  repId       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rep      User                @relation(fields: [repId], references: [id], onDelete: Cascade)
  sessions AttendanceSession[]

  @@unique([courseCode, repId])
}

// ============================================
// ATTENDANCE SESSIONS
// ============================================

model AttendanceSession {
  id         String   @id @default(cuid())
  courseId   String
  locationId String
  shareCode  String   @unique // Short code for sharing (e.g., "ABC123")
  startTime  DateTime @default(now())
  endTime    DateTime
  isActive   Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  location    Location     @relation(fields: [locationId], references: [id])
  attendances Attendance[]
}

// ============================================
// ATTENDANCE RECORDS
// ============================================

model Attendance {
  id                String   @id @default(cuid())
  sessionId         String
  matricNumber      String
  studentName       String
  signedLatitude    Float
  signedLongitude   Float
  deviceFingerprint String  // Hardware-based fingerprint to prevent same device signing for multiple students
  isManualEntry     Boolean @default(false) // True if manually added by course rep
  signedAt          DateTime @default(now())

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, matricNumber]) // One student can only sign once per session
  @@unique([sessionId, deviceFingerprint]) // One device can only sign once per session
}
